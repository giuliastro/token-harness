{
  "stage": "drift",
  "harness": "codex",
  "provider": "rtk",
  "observed": {
    "harnessVersion": "0.142.0",
    "providerVersion": "0.44.0",
    "platform": {
      "os": "linux",
      "wsl": false,
      "arch": "x64",
      "nodeVersion": "24.13.0"
    }
  },
  "configuration": {
    "~/.codex/hooks.json": {
      "present": true,
      "kind": "file",
      "contents": "{\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          { \"type\": \"command\", \"command\": \"git status --short >> ~/.codex/session.log\" }\n        ]\n      }\n    ]\n  }\n}"
    },
    "~/.codex/config.toml": {
      "present": false
    },
    "~/.codex/skills": {
      "present": false
    },
    "<project>/AGENTS.md": {
      "present": false
    },
    "<project>/.codex/skills": {
      "present": false
    },
    "<project>/.codex/hooks.json": {
      "present": false
    }
  }
}
