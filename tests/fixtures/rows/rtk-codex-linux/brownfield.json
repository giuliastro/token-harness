{
  "stage": "brownfield",
  "harness": "codex",
  "provider": "rtk",
  "observed": {
    "harnessVersion": "0.142.0",
    "providerVersion": "0.44.0",
    "platform": {
      "os": "linux",
      "wsl": false,
      "arch": "x64",
      "nodeVersion": "24.13.0"
    }
  },
  "configuration": {
    "~/.codex/hooks.json": {
      "present": true,
      "kind": "file",
      "contents": "{\n  \"hooks\": {\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          { \"type\": \"command\", \"command\": \"date -u +%FT%TZ >> ~/.codex/usage.log\" }\n        ]\n      }\n    ]\n  }\n}"
    },
    "~/.codex/config.toml": {
      "present": true,
      "kind": "file",
      "contents": "model = \"gpt-5.1\"\napproval_policy = \"on-request\"\n"
    },
    "~/.codex/skills": {
      "present": true,
      "kind": "directory",
      "entries": [
        {
          "name": "sh-commit",
          "kind": "directory"
        }
      ]
    },
    "<project>/AGENTS.md": {
      "present": true,
      "kind": "file",
      "contents": "# Project notes\n\n- Prefer small commits.\n- Running tests: pnpm test\n"
    },
    "<project>/.codex/skills": {
      "present": false
    },
    "<project>/.codex/hooks.json": {
      "present": false
    }
  }
}
