{
  "stage": "brownfield",
  "harness": "claude",
  "provider": "rtk",
  "observed": {
    "harnessVersion": "2.1.220",
    "providerVersion": "0.44.0",
    "platform": {
      "os": "windows",
      "wsl": false,
      "arch": "x64",
      "nodeVersion": "24.13.1"
    }
  },
  "configuration": {
    "~/.claude/settings.json": {
      "present": true,
      "kind": "file",
      "contents": "{\n  \"hooks\": {\n    \"PreToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          { \"type\": \"command\", \"command\": \"rtk hook claude\" }\n        ]\n      },\n      {\n        \"matcher\": \"Write|Edit\",\n        \"hooks\": [\n          { \"type\": \"command\", \"command\": \"node C:/Users/dev/scripts/audit-writes.mjs\" }\n        ]\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"matcher\": \"Bash\",\n        \"hooks\": [\n          { \"type\": \"command\", \"command\": \"node C:/Users/dev/scripts/log-commands.mjs\" }\n        ]\n      }\n    ]\n  },\n  \"permissions\": { \"allow\": [\"Bash(git status)\"] }\n}\n"
    },
    "~/.claude/settings.local.json": {
      "present": false
    },
    "~/.claude/skills": {
      "present": false
    },
    "<project>/.claude/settings.json": {
      "present": false
    },
    "<project>/CLAUDE.md": {
      "present": false
    },
    "<project>/.claude/skills": {
      "present": false
    }
  }
}
