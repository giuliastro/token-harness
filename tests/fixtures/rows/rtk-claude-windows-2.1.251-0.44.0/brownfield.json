{
  "stage": "brownfield",
  "harness": "claude",
  "provider": "rtk",
  "observed": {
    "harnessVersion": "2.1.251",
    "providerVersion": "0.44.0",
    "platform": {
      "os": "windows",
      "wsl": false,
      "arch": "x64",
      "nodeVersion": "22.13.0"
    }
  },
  "configuration": {
    "~/.claude/settings.json": {
      "present": true,
      "kind": "file",
      "contents": "{\r\n  \"theme\": \"dark\",\r\n  \"hooks\": {\r\n    \"PreToolUse\": [\r\n      {\r\n        \"matcher\": \"Write|Edit\",\r\n        \"hooks\": [\r\n          { \"type\": \"command\", \"command\": \"my-own-linter --strict\" }\r\n        ]\r\n      }\r\n    ]\r\n  },\r\n  \"permissions\": { \"allow\": [\"Read\", \"Write\"] }\r\n}\r\n"
    },
    "~/.claude/settings.local.json": {
      "present": false
    },
    "~/.claude/skills": {
      "present": false
    },
    "<project>/.claude/settings.json": {
      "present": false
    },
    "<project>/CLAUDE.md": {
      "present": false
    },
    "<project>/.claude/skills": {
      "present": false
    }
  }
}
