{
  "name": "token-harness-workspace",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test --test-reporter=spec \"packages/*/dist/test/**/*.test.js\" \"apps/*/dist/test/**/*.test.js\" \"tests/dist/integration/**/*.test.js\" && node --test --test-reporter=spec \"apps/desktop/test/*.test.mjs\"",
    "build": "tsc -b && node scripts/bundle.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "golden": "node tests/tools/scenarios.mjs && node tests/tools/regenerate-golden.mjs",
    "matrices": "tsc -b && node tests/tools/matrices.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && node dist/bundle/token-harness.mjs",
    "desktop:build": "pnpm build && pnpm package && node scripts/desktop-stage.mjs",
    "desktop:package": "pnpm desktop:build && electron-builder --config dist/desktop/electron-builder.json --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.13.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
